NEXT_PUBLIC_SITE_URL=https://your-verified-domain.co.za
# Keep unset until a real domain and reviewed content are ready for indexing.
SITE_INDEXABLE=false
# Server-only HTTPS endpoint accepting JSON. May be a Firebase HTTPS Function.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
# Optional distributed bot protection; configure both keys together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
